{
  "name": "masto",
  "description": "Mastodon API client for JavaScript, TypeScript, Node.js, browsers",
  "private": false,
  "version": "8.0.0",
  "author": "Ryo Igarashi <n33t5hin@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./*.js": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "npm-run-all test:*",
    "test:typecheck": "tsc --project tsconfig.test.json",
    "test:unit": "vitest --project unit",
    "test:e2e": "vitest --project e2e",
    "lint": "eslint --report-unused-disable-directives --cache",
    "spellcheck": "cspell --quiet --gitignore './**/*.{ts,js}'",
    "format": "prettier './**/*.{ts,js}' --check",
    "build": "tsc --project tsconfig.esm.json",
    "prepublishOnly": "npm run build",
    "docs:build": "typedoc ./src/index.ts && touch ./docs/.nojekyll",
    "purge:cache": "rm -rf ./node_modules/.cache/masto"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "events-to-async": "^2.0.2",
    "ts-custom-error": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@oxc-project/runtime": "^0.156.0",
    "@size-limit/preset-small-lib": "^14.3.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/rule-tester": "^8.72.1",
    "@vitest/coverage-v8": "^5.0.5",
    "cspell": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "get-port": "^7.2.0",
    "ioredis": "^6.0.0",
    "iterator-helpers-polyfill": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "tslib": "^2.9.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "undici": "^8.12.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  },
  "files": [
    "README.md",
    "dist",
    "!**/__tests__",
    "!**/__mocks__"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neet/masto.js.git"
  },
  "keywords": [
    "mastodon",
    "client",
    "activitypub",
    "federated",
    "fediverse"
  ],
  "bugs": {
    "url": "https://github.com/neet/masto.js/issues"
  },
  "homepage": "https://github.com/neet/masto.js#readme",
  "size-limit": [
    {
      "name": "rest",
      "limit": "4.1 kB",
      "path": "./dist/index.js",
      "import": "{ createRestAPIClient }"
    },
    {
      "name": "streaming",
      "limit": "4.0 kB",
      "path": "./dist/index.js",
      "import": "{ createStreamingAPIClient }"
    },
    {
      "name": "oauth",
      "limit": "4.1 kB",
      "path": "./dist/index.js",
      "import": "{ createOAuthAPIClient }"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@12.2.1"
}
